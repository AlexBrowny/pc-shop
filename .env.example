# Скопируйте в .env и заполните. Файл .env не должен попадать в репозиторий.

PORT=3000

# --- Админ-панель (/admin) ---
ADMIN_USER=admin
# Если пароль не задан, при первом запуске будет сгенерирован случайный и показан в консоли один раз.
ADMIN_PASSWORD=

# --- Telegram-бот для чеков ---
# Токен от @BotFather. Chat ID менеджера можно задать здесь или в админке (Настройки).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Stripe: оплата банковской картой (необязательно; без ключа остаётся только оплата по чеку) ---
# Ключ: Stripe Dashboard → Developers → API keys (sk_test_… для теста, sk_live_… для боевого режима).
STRIPE_SECRET_KEY=
# Секрет подписи вебхука: Developers → Webhooks → ваш endpoint → Signing secret (whsec_…).
# URL вебхука: https://<ваш-домен>/api/stripe/webhook, события: checkout.session.completed,
# checkout.session.expired, checkout.session.async_payment_succeeded, checkout.session.async_payment_failed
STRIPE_WEBHOOK_SECRET=
# Адрес сайта для возврата из Stripe (если не задан, берётся из запроса), например https://pc-shop-livid.vercel.app
PUBLIC_URL=

# --- Оплата (показывается покупателю на странице оформления) ---
PAYMENT_CARD=8600 0000 0000 0000
PAYMENT_HOLDER=PC Market

# Курс для сидирования цен (сум за 1 $)
USD_RATE=12500

# --- Neon (Postgres + Object Storage). Значения вносит `neon deploy` / `neon env pull` ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
